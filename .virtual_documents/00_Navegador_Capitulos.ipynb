def obtener_capitulos():
    """Obtiene todos los archivos .md y los organiza de forma robusta por bloques o prefijos."""
    
    if not CHAPTERS_DIR.exists():
        print(f"⚠️ No se encontró el directorio: {CHAPTERS_DIR}")
        return {}
    
    archivos_md = sorted([f for f in CHAPTERS_DIR.glob('*.md') if not f.name.startswith('.')])
    
    bloques = {
        'Prefacio': [],
        'Bloque I - Comportamiento y Psicología': [],
        'Bloque II - Cuantitativas y Arbitraje': [],
        'Bloque III - Estrategias Basadas en Eventos': [],
        'Bloque IV - Macro y Globales': [],
        'Bloque V - Alternativas y Exóticas': [],
        'Bloque VI - Nicho y Tácticas': [],
        'Bloque VII - Alto Riesgo': [],
        'Bloque VIII - Indicadores Técnicos': [],
        'Apéndices': []
    }
    
    for archivo in archivos_md:
        nombre = archivo.stem
        nombre_lower = nombre.lower()
        
        # Clasificación flexible basada en palabras clave o numeración ampliada
        if 'prefacio' in nombre_lower or 'indice' in nombre_lower or 'portada' in nombre_lower or nombre.startswith('00_'):
            bloques['Prefacio'].append(archivo)
        elif 'apendice' in nombre_lower or 'glosario' in nombre_lower:
            bloques['Apéndices'].append(archivo)
        else:
            # Intentamos extraer el número del principio del archivo para asignarlo a su bloque correspondiente
            import re
            match = re.search(r'^(\d+)', nombre)
            if match:
                num = int(match.group(1))
                if 1 <= num <= 4:
                    bloques['Bloque I - Comportamiento y Psicología'].append(archivo)
                elif 5 <= num <= 7:
                    bloques['Bloque II - Cuantitativas y Arbitraje'].append(archivo)
                elif 8 <= num <= 10:
                    bloques['Bloque III - Estrategias Basadas en Eventos'].append(archivo)
                elif 11 <= num <= 13:
                    bloques['Bloque IV - Macro y Globales'].append(archivo)
                elif 14 <= num <= 16:
                    bloques['Bloque V - Alternativas y Exóticas'].append(archivo)
                elif 17 <= num <= 20:
                    bloques['Bloque VI - Nicho y Tácticas'].append(archivo)
                elif 21 <= num <= 23:
                    bloques['Bloque VII - Alto Riesgo'].append(archivo)
                elif num >= 24:
                    bloques['Bloque VIII - Indicadores Técnicos'].append(archivo)
                else:
                    bloques['Prefacio'].append(archivo)
            else:
                # Si no tiene número explícito, va por defecto al prefacio o general
                bloques['Prefacio'].append(archivo)
    
    return {k: v for k, v in bloques.items() if v}

capitulos_organizados = obtener_capitulos()
total = sum(len(v) for v in capitulos_organizados.values())
print(f"✅ Se encontraron {total} capítulos organizados en {len(capitulos_organizados)} bloques\n")

