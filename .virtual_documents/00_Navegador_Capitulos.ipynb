# Celda 4: Funciones de visualización (backup)
def ver_capitulo(numero_capitulo):
    """Visualiza las primeras 30 líneas de un capítulo."""
    
    archivo_encontrado = None
    for bloque, archivos in capitulos_organizados.items():
        for archivo in archivos:
            if str(numero_capitulo).zfill(2) in archivo.stem:
                archivo_encontrado = archivo
                break
        if archivo_encontrado:
            break
    
    if not archivo_encontrado:
        print(f"❌ No se encontró el capítulo {numero_capitulo}")
        return
    
    print(f"📖 Visualizando: {archivo_encontrado.name}")
    print("="*70)
    
    with open(archivo_encontrado, 'r', encoding='utf-8') as f:
        lineas = f.readlines()[:30]
        for linea in lineas:
            print(linea.strip())
    
    if len(open(archivo_encontrado, 'r', encoding='utf-8').readlines()) > 30:
        print("\n... (contenido truncado, usar leer_capitulo_completo() para ver todo)")

def leer_capitulo_completo(numero_capitulo):
    """Lee y muestra el contenido completo de un capítulo en Markdown."""
    
    archivo_encontrado = None
    for bloque, archivos in capitulos_organizados.items():
        for archivo in archivos:
            if str(numero_capitulo).zfill(2) in archivo.stem:
                archivo_encontrado = archivo
                break
        if archivo_encontrado:
            break
    
    if archivo_encontrado:
        with open(archivo_encontrado, 'r', encoding='utf-8') as f:
            contenido = f.read()
        display(Markdown(contenido))
    else:
        print(f"❌ No se encontró el capítulo {numero_capitulo}")

