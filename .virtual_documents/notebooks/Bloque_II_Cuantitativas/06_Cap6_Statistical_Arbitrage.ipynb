print(f"   • Umbral entrada (z-score): ±{UMBRAL_ENTRADA}")
print(f"   • Umbral salida (z-score): ±{UMBRAL_SALIDA}")
print(f"   • Umbral stop-loss (z-score): ±{UMBRAL_STOP}")
