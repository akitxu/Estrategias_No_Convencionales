    html += f"<h2>📓 Notebooks del Proyecto ({len(df)} encontrados)</h2>"
    
    if len(df) == 0:
        html += "<p>No se encontraron notebooks con los filtros aplicados.</p>"
    
    # Reemplaza TU_USUARIO por tu usuario real de GitHub
